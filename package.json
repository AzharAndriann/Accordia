{
  "name": "accordia-be",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:deploy": "bunx --bun prisma migrate deploy",
    "db:studio": "bunx --bun prisma studio",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/cors": "^2.8.19",
    "@types/express": "5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7",
    "@prisma/client": "7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "5",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  }
}

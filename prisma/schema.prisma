generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  sessions        Session[]
  createdProjects Project[]       @relation("ProjectCreator")
  projectMembers  ProjectMember[]
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  DELIVERED
  COMPLETED
  CANCELLED
}

enum ProjectRole {
  FREELANCER
  CLIENT
}

model Project {
  id                       String          @id @default(uuid()) @db.Uuid
  title                    String          @db.VarChar(160)
  description              String          @db.Text
  creatorId                String          @db.Uuid
  status                   ProjectStatus   @default(DRAFT)
  activeAgreementVersionId String?         @db.Uuid
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  creator                  User            @relation("ProjectCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  members                  ProjectMember[]

  @@index([creatorId])
  @@index([createdAt, id])
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@unique([projectId, role])
  @@index([userId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.Char(64)
  tokenFamilyId    String    @db.Uuid
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([tokenFamilyId])
}
